# Easiest: run  bash configure.sh  — it asks for everything below.
# Or copy to .env and fill in by hand. Never commit .env.

# Passwords for ChargeSplit's own database and Grafana — make up long random ones.
DB_PASSWORD=change-me-long-random
GRAFANA_DB_PASSWORD=change-me-another-long-random
GRAFANA_ADMIN_PASSWORD=change-me-grafana-login

# myenergi: myaccount.myenergi.com -> your hub -> Advanced -> Generate new API key
MYENERGI_HUB_SERIAL=
MYENERGI_API_KEY=

# The name of your home geofence in TeslaMate (emoji prefixes like "🏡 Home" are fine)
HOME_GEOFENCE=Home

# What to call the non-Tesla car on the dashboard (letters, digits, spaces, . _ - ; up to 30)
OTHER_CAR_NAME=Other car

# MQTT broker that TeslaMate publishes to. Defaults suit a standard Docker install.
# MQTT_DOCKER_NETWORK=teslamate_default   # Docker network of your TeslaMate stack
# MQTT_HOST=mosquitto
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TLS=false
# MQTT_TOPIC_PREFIX=teslamate             # change if you set MQTT_NAMESPACE in TeslaMate

# Grafana port on this machine
# GRAFANA_PORT=3001
